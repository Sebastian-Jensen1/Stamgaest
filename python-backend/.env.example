# Kopiér til .env (i denne mappe) og udfyld. .env er gitignored og må ikke committes.

PORT=3000

# Den fælles database på Neon. Hent strengen i Neon-dashboardet under "Connect".
# Spørg Magnus eller Sebastian om den; den står bevidst ikke i Git.
#
# Databasen hedder neondb — det er den Neon selv opretter. Du skal ikke oprette
# en der hedder feedbackfox; vores tabeller ligger inde i neondb.
#
# Skriv sslmode=verify-full som her, selvom Neon giver dig strengen med
# sslmode=require. Det ændrer ikke sikkerheden (app/db/pool.py kræver et gyldigt
# certifikat uanset hvad der står i strengen), men det viser hvad der faktisk sker.
#
DATABASE_URL=postgresql://BRUGER:ADGANGSKODE@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full

# Vil du hellere arbejde mod din egen lokale database (Postgres.app), så brug
# denne i stedet — så rører du ikke fælles data:
# DATABASE_URL=postgresql://DIT_BRUGERNAVN@localhost:5432/feedbackfox

ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- Valgfrit ---------------------------------------------------------------
#
# Modellen der skriver udkastene. Standard er claude-sonnet-4-6.
# CLAUDE_MODEL=claude-sonnet-4-6
#
# Hvilke værtsnavne serveren svarer på (kommasepareret). Standard er kun
# localhost og 127.0.0.1. Det beskytter mod at en fremmed hjemmeside får din
# browser til at kalde din lokale server ("DNS rebinding"). Kør du serveren
# et andet sted, skal dets domæne stå her.
# ALLOWED_HOSTS=localhost,127.0.0.1
#
# Tænder /docs og /openapi.json (en oversigt over API'et). Slukket som standard.
# ENABLE_DOCS=1
#
# Sæt til 1, når siden ligger på et rigtigt domæne med HTTPS. Så sendes login-cookien
# kun over HTTPS. Lokalt (http://localhost) skal den være slukket, ellers virker login ikke.
# COOKIE_SECURE=1
