# Kopiér til .env (i denne mappe) og udfyld. .env er gitignored og må ikke committes.

PORT=3000

# Den fælles database på Neon. Hent strengen i Neon-dashboardet under "Connect".
# Spørg Magnus eller Sebastian om den; den står bevidst ikke i Git.
#
# Databasen hedder neondb — det er den Neon selv opretter. Du skal ikke oprette
# en der hedder feedbackfox; vores tabeller ligger inde i neondb.
#
# Skriv sslmode=verify-full som her, selvom Neon giver dig strengen med
# sslmode=require. Det ændrer ikke sikkerheden (app/db/pool.py kræver et gyldigt
# certifikat uanset hvad der står i strengen), men det viser hvad der faktisk sker.
#
DATABASE_URL=postgresql://BRUGER:ADGANGSKODE@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full

# Vil du hellere arbejde mod din egen lokale database (Postgres.app), så brug
# denne i stedet — så rører du ikke fælles data:
# DATABASE_URL=postgresql://DIT_BRUGERNAVN@localhost:5432/feedbackfox

ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=

RESEND_API_KEY=

# --- Valgfrit ---------------------------------------------------------------
#
# Modellen der skriver udkastene. Standard er claude-sonnet-4-6.
# CLAUDE_MODEL=claude-sonnet-4-6
#
# Modellen der mærker anmeldelser med emner til statistikken. Standard er claude-haiku-5-5.
# CLAUDE_TOPICS_MODEL=claude-haiku-5-5
#
# Hvilke værtsnavne serveren svarer på (kommasepareret). Standard er kun
# localhost og 127.0.0.1. Det beskytter mod at en fremmed hjemmeside får din
# browser til at kalde din lokale server ("DNS rebinding"). Kør du serveren
# et andet sted, skal dets domæne stå her.
# ALLOWED_HOSTS=localhost,127.0.0.1
#
# Tænder /docs og /openapi.json (en oversigt over API'et). Slukket som standard.
# ENABLE_DOCS=1
#
# Sæt til 1, når siden ligger på et rigtigt domæne med HTTPS. Så sendes login-cookien
# kun over HTTPS. Lokalt (http://localhost) skal den være slukket, ellers virker login ikke.
# COOKIE_SECURE=1
#
# Mails (glemt adgangskode) sendes via Resend (resend.com). Uden nøglen sendes der ingen mails.
# RESEND_API_KEY=
#
# Afsenderen. Adressen skal høre til et domæne der er bekræftet hos Resend (SPF/DKIM i Cloudflare).
# Standard er Resends testafsender, som kun kan sende til din egen mail.
# MAIL_FROM=Stamgæst <noreply@mail.stamgaest.com>
#
# Adressen siden ligger på. Linket i mailen bygges ud fra den. Standard: http://localhost:PORT.
# I drift: APP_BASE_URL=https://stamgaest.com
# Kører serveren bag en tunnel eller på et rigtigt domæne: tilføj domænet i ALLOWED_HOSTS,
# sæt COOKIE_SECURE=1 og APP_BASE_URL=https://dit-domæne. Se QUICKSTART.md. Serveren nægter at
# starte, hvis COOKIE_SECURE=1 er sat uden en https-APP_BASE_URL.

# --- Hosting ------------------------------------------------------------------
#
# Hvilken adresse serveren lytter på. Standard 127.0.0.1 = kun denne maskine. Hos en host: 0.0.0.0.
# Serveren nægter at starte med andet end 127.0.0.1, hvis COOKIE_SECURE=1 ikke er sat.
# HOST=0.0.0.0
#
# Proxyer der må fortælle kundens rigtige IP (X-Forwarded-For). IP-adresser og net adskilt af
# komma. "cloudflare" tilføjer Cloudflares net. Standard: 127.0.0.1 (Cloudflare-tunnelen).
# "*" er ikke tilladt, for så kunne enhver selv vælge sin IP. Se README, afsnittet "Hosting".
# TRUSTED_PROXIES=10.0.0.0/8,cloudflare

# --- Lofter for betalte kald (Claude og Google) ------------------------------
#
# Lofterne gemmes i databasen og holder derfor også efter en genstart. Dag og måned regnes i
# dansk tid. "CAFE" er pr. café (uanset antal brugere), "TOTAL" er for hele Stamgæst. Ret tallet
# og genstart serveren. Standardværdierne står her:
#
# Udkast fra Claude (ca. 0,04 kr. pr. udkast med claude-sonnet-4-6)
# CAP_DRAFTS_CAFE_DAY=100
# CAP_DRAFTS_CAFE_MONTH=1000
# CAP_DRAFTS_TOTAL_DAY=1000
# CAP_DRAFTS_TOTAL_MONTH=10000
#
# Hentninger fra Google Places
# CAP_FETCHES_CAFE_DAY=20
# CAP_FETCHES_CAFE_MONTH=300
# CAP_FETCHES_TOTAL_DAY=200
# CAP_FETCHES_TOTAL_MONTH=3000
#
# "Lav forslag fra jeres hjemmeside" (Claude læser hjemmesiden, nogle kroner pr. gang)
# CAP_PROFILES_CAFE_DAY=3
# CAP_PROFILES_CAFE_MONTH=10
# CAP_PROFILES_TOTAL_DAY=30
# CAP_PROFILES_TOTAL_MONTH=200
#
# Mærkning af anmeldelser med emner til statistikken (pr. kald, ét kald mærker op til 10)
# CAP_TOPICS_CAFE_DAY=30
# CAP_TOPICS_CAFE_MONTH=200
# CAP_TOPICS_TOTAL_DAY=300
# CAP_TOPICS_TOTAL_MONTH=3000
#
# Hvem får en mail, når et loft når 80 % og 100 % (kræver RESEND_API_KEY).
# ADMIN_EMAIL=stamgaest.kontakt@gmail.com
#
# Nødbremse: 1 slår alle kald til Claude fra for ALLE caféer (udkast, profiler og emner). Genstart serveren bagefter.
# AI_PAUSED=1
#
# Claudes pris i USD pr. million tokens. Bruges kun til det anslåede beløb i `usage`.
# CLAUDE_PRICE_INPUT_PER_MTOK=3
# CLAUDE_PRICE_OUTPUT_PER_MTOK=15
